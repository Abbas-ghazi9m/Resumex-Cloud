# ========================================================
# RESUMEX-CLOUD ENVIRONMENT CONFIGURATION
# ========================================================

# Application Core
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=127.0.0.1
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# Security & Tokens
NEXTAUTH_SECRET=resumex-cloud-production-jwt-secret-key-replace-in-prod-2026!#$
SECRET_KEY=resumex-cloud-production-jwt-secret-key-replace-in-prod-2026!#$

# Database
# Local SQLite (zero-config local dev):
DATABASE_URL=sqlite:///./resumex.db
# Cloud PostgreSQL (AWS RDS / Supabase / Neon):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/resumex_cloud

# Storage Provider: 'local' or 's3'
STORAGE_PROVIDER=local
MAX_FILE_SIZE_MB=15

# S3 / Cloudflare R2 / MinIO Compatible Vault (Required if STORAGE_PROVIDER=s3)
S3_ENDPOINT=
S3_BUCKET=resumex-vault
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# Optional AI Providers (Deterministic NLP fallback runs automatically when keys are omitted)
AI_PROVIDER=auto
OPENAI_API_KEY=
GEMINI_API_KEY=

# Cache / Queue (Optional)
REDIS_URL=redis://localhost:6379/0

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
